# Copy this file to .env and fill in all values before starting the stack.
# .env is git-ignored and must never be committed.

# Flask session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Portal login credentials shown to players/staff
PORTAL_LOGIN=ZAWODNICY_GTK
PORTAL_PASS=change-me-to-a-strong-password

# Set to "true" once nginx serves HTTPS (requires valid TLS cert)
SESSION_COOKIE_SECURE=false
